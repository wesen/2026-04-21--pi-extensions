#!/usr/bin/env bash
# Add Pi session metadata to commit messages when the commit is made from Pi.
# Install this file as a commit-msg hook, for example:\n#   cp scripts/git-hooks/commit-msg .git/hooks/commit-msg

set -euo pipefail

message_file=${1:?commit message file is required}

add_trailer() {
  local key=$1
  local value=$2

  [[ -n "$value" ]] || return 0

  # Make the hook idempotent so amend/retry operations do not duplicate trailers.
  if ! grep -qF "$key:" "$message_file"; then
    git interpret-trailers --in-place --trailer "$key: $value" "$message_file"
  fi
}

add_trailer "Pi-Session" "${PI_AGENT_SESSION_ID:-}"
add_trailer "Pi-Turn" "${PI_AGENT_TURN_NUMBER:-${PI_AGENT_TURN_INDEX:-}}"
add_trailer "Pi-Model" "${PI_AGENT_MODEL_NAME:-${PI_AGENT_MODEL_ID:-}}"

# For workspaces such as ~/workspaces/2026-07-24/datadrop-mcp, retain only
# 2026-07-24/datadrop-mcp. PI_AGENT_CWD is the Pi workspace root when present.
cwd=${PI_AGENT_CWD:-}
workspace_root="$HOME/workspaces/"
if [[ -n "$cwd" && "$cwd" == "$workspace_root"* ]]; then
  workspace=${cwd#"$workspace_root"}
  if [[ "$workspace" =~ ^([0-9]{4}-[0-9]{2}-[0-9]{2}/[^/]+) ]]; then
    add_trailer "Workspace" "${BASH_REMATCH[1]}"
  fi
fi
